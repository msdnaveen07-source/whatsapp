# App Environment & Server Config
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_SECRET="whcrm_super_secret_jwt_key_2026_change_in_prod"

# Database Connection (SQLite for zero-setup dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Development & Test Mode Flag
# Set to "true" to run in Mock Mode without calling Meta API
WHATSAPP_MOCK_MODE="true"

# Meta WhatsApp Cloud API Credentials
META_APP_ID="123456789012345"
META_APP_SECRET="0123456789abcdef0123456789abcdef"
META_ACCESS_TOKEN="EAAG..."
META_WABA_ID="100987654321098"
META_PHONE_NUMBER_ID="105432109876543"
META_GRAPH_API_VERSION="v21.0"

# Custom Webhook Verification Token generated by application
# DO NOT USE Meta Access Token here. Use a random secret token.
META_WEBHOOK_VERIFY_TOKEN="whcrm_verify_9f7d3a2c8b6e4a1f"
