datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String               @id @default(uuid())
  email          String               @unique
  name           String
  passwordHash   String
  avatarUrl      String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  memberships    OrganizationMember[]
  assignedChats  Conversation[]       @relation("AssignedAgent")
  notes          Note[]
  auditLogs      AuditLog[]
}

model Organization {
  id                 String               @id @default(uuid())
  name               String
  slug               String               @unique
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  members            OrganizationMember[]
  whatsappConnection WhatsAppConnection?
  contacts           Contact[]
  conversations      Conversation[]
  messages           Message[]
  templates          Template[]
  campaigns          Campaign[]
  tags               Tag[]
  notes              Note[]
  apiLogs            ApiLog[]
  auditLogs          AuditLog[]
  webhookEvents      WebhookEvent[]
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           String       @default("AGENT") // OWNER, ADMIN, AGENT
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model WhatsAppConnection {
  id                 String       @id @default(uuid())
  organizationId     String       @unique
  appId              String?
  appSecret          String?
  accessToken        String?
  wabaId             String?
  phoneNumberId      String?
  phoneNumber        String?
  webhookVerifyToken String
  graphApiVersion    String       @default("v21.0")
  status             String       @default("DISCONNECTED") // CONNECTED, DISCONNECTED, INVALID_TOKEN, TOKEN_EXPIRED, CONFIG_ERROR
  webhookStatus      String       @default("NOT_VERIFIED") // VERIFIED, NOT_VERIFIED
  lastTestedAt       DateTime?
  lastErrorMessage   String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Contact {
  id               String              @id @default(uuid())
  organizationId   String
  name             String
  phone            String
  whatsappId       String?
  email            String?
  source           String              @default("MANUAL") // MANUAL, IMPORT, INBOUND_MESSAGE
  lastContacted    DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations    Conversation[]
  messages         Message[]
  contactTags      ContactTag[]
  notes            Note[]
  campaignRecipients CampaignRecipient[]

  @@unique([organizationId, phone])
}

model Tag {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  color          String       @default("#3B82F6")
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactTags    ContactTag[]

  @@unique([organizationId, name])
}

model ContactTag {
  id        String   @id @default(uuid())
  contactId String
  tagId     String
  createdAt DateTime @default(now())

  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contactId, tagId])
}

model Note {
  id             String       @id @default(uuid())
  organizationId String
  contactId      String
  userId         String
  content        String
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  author         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id             String       @id @default(uuid())
  organizationId String
  contactId      String
  assignedUserId String?
  status         String       @default("OPEN") // OPEN, CLOSED
  unreadCount    Int          @default(0)
  lastMessageAt  DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedAgent  User?        @relation("AssignedAgent", fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages       Message[]
}

model Message {
  id                 String          @id @default(uuid())
  organizationId     String
  conversationId     String
  contactId          String
  metaMessageId      String?         @unique
  direction          String          // INBOUND, OUTBOUND
  messageType        String          // TEXT, IMAGE, VIDEO, AUDIO, DOCUMENT, LOCATION, TEMPLATE, INTERACTIVE
  text               String?
  mediaUrl           String?
  mimeType           String?
  caption            String?
  templateName       String?
  templateLanguage   String?
  templateParameters String?         // JSON string array or object
  status             String          @default("QUEUED") // QUEUED, SENT, DELIVERED, READ, FAILED
  errorCode          String?
  errorMessage       String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation       Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact            Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  statuses           MessageStatus[]
}

model MessageStatus {
  id        String   @id @default(uuid())
  messageId String
  status    String   // SENT, DELIVERED, READ, FAILED
  timestamp DateTime @default(now())
  error     String?

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model Template {
  id              String              @id @default(uuid())
  organizationId  String
  metaTemplateId  String?
  name            String
  language        String              @default("en_US")
  category        String              // MARKETING, UTILITY, AUTHENTICATION
  status          String              @default("DRAFT") // DRAFT, PENDING, APPROVED, REJECTED, DISABLED
  rejectionReason String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  components      TemplateComponent[]
  campaigns       Campaign[]

  @@unique([organizationId, name, language])
}

model TemplateComponent {
  id         String   @id @default(uuid())
  templateId String
  type       String   // HEADER, BODY, FOOTER, BUTTONS
  format     String?  // TEXT, IMAGE, VIDEO, DOCUMENT (for HEADER)
  text       String?
  buttons    String?  // JSON string for quick replies / URLs / calls
  example    String?  // JSON string for header/body variable examples

  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model Campaign {
  id             String              @id @default(uuid())
  organizationId String
  templateId     String
  name           String
  status         String              @default("DRAFT") // DRAFT, SCHEDULED, RUNNING, COMPLETED, PAUSED, FAILED
  scheduledAt    DateTime?
  sentCount      Int                 @default(0)
  deliveredCount Int                 @default(0)
  readCount      Int                 @default(0)
  failedCount    Int                 @default(0)
  totalTarget    Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template       Template            @relation(fields: [templateId], references: [id])
  recipients     CampaignRecipient[]
}

model CampaignRecipient {
  id         String   @id @default(uuid())
  campaignId String
  contactId  String
  status     String   @default("PENDING") // PENDING, SENT, DELIVERED, READ, FAILED
  variables  String?  // JSON key-value map for {{1}}, {{2}}
  error      String?
  sentAt     DateTime?

  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id             String        @id @default(uuid())
  organizationId String?
  eventId        String?       @unique
  eventType      String        // message, status, unknown
  payload        String        // JSON raw string
  processed      Boolean       @default(false)
  error          String?
  createdAt      DateTime      @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
}

model ApiLog {
  id             String        @id @default(uuid())
  organizationId String?
  endpoint       String
  method         String
  requestType    String        // WEBHOOK, MESSAGE, TEMPLATE, CAMPAIGN, SYSTEM
  statusCode     Int
  durationMs     Int
  requestBody    String?
  responseBody   String?
  errorMessage   String?
  createdAt      DateTime      @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  details        String?
  ipAddress      String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
}
